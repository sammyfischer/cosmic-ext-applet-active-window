[Desktop Entry]
Name=Active Window
Comment=Shows the active window text
Type=Application
Icon=com.github.sammyfischer.ActiveWindowApplet
Exec=cosmic-applet-active-window %F
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
MimeType=

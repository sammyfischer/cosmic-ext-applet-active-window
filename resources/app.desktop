[Desktop Entry]
Name=Active Window
Comment=View and manage the currently focused application
Type=Application
Icon=com.github.sammyfischer.ActiveWindowApplet
Exec=cosmic-ext-applet-active-window %F
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-HostWaylandDisplay=true
MimeType=
